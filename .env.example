# ─── Required ────────────────────────────────────────────────────────────
# The Astroport-code factory the swap reads pools from. The one Terra Swap
# runs on (ownership and admin renounced, see README):
NEXT_PUBLIC_DEX_FACTORY=terra1gx7n4yrfc2req7tdt9vpj66kr0cssnqkjsr80xmfacjpdlw6mzlqvlp3xd

# ─── Optional ────────────────────────────────────────────────────────────
# Terra Predict contract. Empty → /predict shows "not live yet".
NEXT_PUBLIC_PREDICT_CONTRACT=

# Chain endpoints (any public Terra LCD/RPC works).
NEXT_PUBLIC_LCD=https://terra-lcd.publicnode.com
NEXT_PUBLIC_RPC=https://terra-rpc.publicnode.com:443

# WalletConnect Cloud project id — only needed for mobile wallets (Keplr Mobile).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# cw721 collection whose holders get 1.5× points on the board. Empty to disable.
NEXT_PUBLIC_BOOST_CW721=terra1htnzmetd2xlkgrqqdf3whu8wzwhtjlx7ahrk6qsxxneaktl63r9sx5v2uk

# Vercel KV (Upstash Redis) for the board, the arcade scores and price caches.
# Without it everything still works; the board just lives in memory per instance.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Countries where wallet actions are withheld (pages and data stay open).
BLOCKED_COUNTRIES=US,CA,GB
# ?bypass=<secret> sets a cookie that lifts the gate, for testing from a listed country.
GEOBLOCK_BYPASS_SECRET=
